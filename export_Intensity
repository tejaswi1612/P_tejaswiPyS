from pathlib import Path
import csv
import shutil
import win32com.client

jobs = Path(r"C:\Users\tpasupu\AppData\Local\Temp\jobs")
out = Path(r"C:\T1\Python\export_intensity")
out.mkdir(exist_ok=True)

xmps = sorted(jobs.glob("**/Intensity.1.xmp"), key=lambda p: p.stat().st_mtime, reverse=True)
if not xmps:
    raise SystemExit("No Intensity.1.xmp under Temp\\jobs — run the intensity sim first.")
xmp = xmps[0]
print("using", xmp)

viewer = win32com.client.Dispatch("XmpViewer.Application")
try:
    viewer.Show(0)
except Exception:
    pass

if int(viewer.OpenFile(str(xmp))) == 0:
    raise SystemExit("OpenFile failed")

map_txt = out / "Intensity.1_map.txt"
meas_txt = out / "Intensity.1_measures.txt"
for pth in (map_txt, meas_txt):
    if pth.exists():
        pth.unlink()

viewer.ExportTXT(str(map_txt))
viewer.MeasuresExportTXT(str(meas_txt))

def to_csv(txt_path):
    csv_path = txt_path.with_suffix(".csv")
    text = txt_path.read_text(encoding="utf-8", errors="replace")
    if "\t" in text:
        with csv_path.open("w", newline="", encoding="utf-8") as f:
            csv.writer(f).writerows(line.split("\t") for line in text.splitlines())
    else:
        shutil.copyfile(txt_path, csv_path)
    print(txt_path.name, "bytes", txt_path.stat().st_size, "->", csv_path.name)

if map_txt.exists():
    to_csv(map_txt)
else:
    print("FAIL map")
if meas_txt.exists():
    to_csv(meas_txt)
else:
    print("FAIL measures")

print("done", out)

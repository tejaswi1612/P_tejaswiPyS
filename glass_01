from ansys.speos.core.speos import Speos
from ansys.speos.core.project import Project
from ansys.speos.core.face import Face
from ansys.speos.core.source import SourceSurface
from ansys.speos.core.sensor import SensorXMPIntensity
from ansys.speos.core.simulation import SimulationDirect
from ansys.speos.core.kernel.client import default_local_channel

speos = Speos(channel=default_local_channel(port=50098))
p = Project(speos=speos)
root = p.create_root_part().commit()

def add_face(body, name, vertices, facets, normals):
    f = body.create_face(name=name)
    f.vertices = vertices
    f.facets = facets
    f.normals = normals
    f.commit()

# Lamp triangle at z=0 (still a SOURCE, not glass)
body_lamp = root.create_body(name="TheBodyB").commit()
add_face(
    body_lamp, "TheFaceF",
    [0, 0, 0, 10, 0, 0, 0, 10, 0],
    [0, 1, 2],
    [0, 0, 1, 0, 0, 1, 0, 0, 1],
)
face1 = p.find(name="TheBodyB/TheFaceF", feature_type=Face)[0]
source = p.create_source(name="Source.1", feature_type=SourceSurface)
source.set_exitance_constant().geometries = [(face1, False)]
source.commit()
print("STEP 1  lamp ok")

# Closed box at z=9..11 mm — glass needs THICKNESS (a volume), not a single film
body_g = root.create_body(name="TheBodyGlass").commit()
# bottom z=9
add_face(body_g, "Bot", [0,0,9, 8,0,9, 8,8,9, 0,8,9], [0,1,2, 0,2,3], [0,0,-1]*4)
# top z=11
add_face(body_g, "Top", [0,0,11, 0,8,11, 8,8,11, 8,0,11], [0,1,2, 0,2,3], [0,0,1]*4)
# sides
add_face(body_g, "Y0", [0,0,9, 8,0,9, 8,0,11, 0,0,11], [0,1,2, 0,2,3], [0,-1,0]*4)
add_face(body_g, "Y8", [0,8,9, 0,8,11, 8,8,11, 8,8,9], [0,1,2, 0,2,3], [0,1,0]*4)
add_face(body_g, "X0", [0,0,9, 0,0,11, 0,8,11, 0,8,9], [0,1,2, 0,2,3], [-1,0,0]*4)
add_face(body_g, "X8", [8,0,9, 8,8,9, 8,8,11, 8,0,11], [0,1,2, 0,2,3], [1,0,0]*4)
print("STEP 2  glass box geometry ok")

mat = p.create_optical_property(name="Material.Glass")
mat.set_surface_opticalpolished()
mat.set_volume_optic(index=1.5, absorption=0.0, constringence=60)
mat.geometries = [body_g]  # glass on the box only, not the lamp
mat.commit()
print("STEP 3  glass SOP/VOP committed")

sensor = p.create_sensor(name="Intensity.1", feature_type=SensorXMPIntensity)
sensor.x_start, sensor.x_end = -45, 45
sensor.y_start, sensor.y_end = -30, 30
sensor.x_sampling, sensor.y_sampling = 90, 60
sensor.axis_system = [5, 5, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1]
sensor.commit()
print("STEP 4  intensity sensor ok")

sim = p.create_simulation(name="Direct.1", feature_type=SimulationDirect)
sim.sensor_paths = [sensor]
sim.source_paths = [source]
sim.stop_condition_rays_number = 80000
sim.commit()
print("STEP 5  computing...")
print(sim.compute_CPU())
speos.close()
print("STEP 6  closed — open NEW Intensity.1.xmp (cd). Compare to the speckle map with no glass.")

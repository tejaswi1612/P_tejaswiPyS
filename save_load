from pathlib import Path
from ansys.speos.core.speos import Speos
from ansys.speos.core.project import Project
from ansys.speos.core.face import Face
from ansys.speos.core.source import SourceSurface
from ansys.speos.core.kernel.client import default_local_channel

SAVE = Path(r"C:\T1\Python\my_toy_scene.speoslightbox")

speos = Speos(channel=default_local_channel(port=50098))
p = Project(speos=speos)

root = p.create_root_part().commit()
body = root.create_body(name="TheBodyB").commit()
face = body.create_face(name="TheFaceF")
face.vertices = [0, 0, 0, 10, 0, 0, 0, 10, 0]
face.facets = [0, 1, 2]
face.normals = [0, 0, 1, 0, 0, 1, 0, 0, 1]
face.commit()
face1 = p.find(name="TheBodyB/TheFaceF", feature_type=Face)[0]

source = p.create_source(name="Source.1", feature_type=SourceSurface)
source.set_exitance_constant().geometries = [(face1, False)]
source.spectrum.set_blackbody()
source.commit()
print("STEP 1  built toy scene")
print("         scene_link methods:", [n for n in dir(p.scene_link) if not n.startswith("_")])

# Correct API name: save_file (not save)
p.scene_link.save_file(file_uri=str(SAVE))
print("STEP 2  saved:", SAVE, "exists=", SAVE.exists())

speos.close()

# Load into a new session
speos2 = Speos(channel=default_local_channel(port=50098))
p2 = Project(speos=speos2, path=str(SAVE))
print("STEP 3  loaded")
print("         sources:", p2.sources)
print("         sensors:", p2.sensors)
print(p2)
speos2.close()
print("STEP 4  done")

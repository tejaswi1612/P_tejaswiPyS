from pathlib import Path

from ansys.speos.core.speos import Speos
from ansys.speos.core.project import Project
from ansys.speos.core.face import Face
from ansys.speos.core.source import SourceSurface
from ansys.speos.core.component import LightBoxFileInstance
from ansys.speos.core.generic.file_transfer import FileTransfer
from ansys.speos.core.kernel.client import default_local_channel

SAVE = Path(r"C:\T1\Python\my_toy_scene.speoslightbox").resolve()

# ---------- STEP 1: build toy scene ----------
speos = Speos(channel=default_local_channel(port=50098))
p = Project(speos=speos)

root = p.create_root_part().commit()
body = root.create_body(name="TheBodyB").commit()
face = body.create_face(name="TheFaceF")
face.vertices = [0, 0, 0, 10, 0, 0, 0, 10, 0]
face.facets = [0, 1, 2]
face.normals = [0, 0, 1, 0, 0, 1, 0, 0, 1]
face.commit()
face1 = p.find(name="TheBodyB/TheFaceF", feature_type=Face)[0]

source = p.create_source(name="Source.1", feature_type=SourceSurface)
source.set_exitance_constant().geometries = [(face1, False)]
source.spectrum.set_blackbody()
source.commit()
print("STEP 1  built")

# ---------- STEP 2: save to disk ----------
p.scene_link.save_file(file_uri=str(SAVE))
print(
    "STEP 2  saved:",
    SAVE,
    "exists=",
    SAVE.exists(),
    "is_file=",
    SAVE.is_file(),
    "is_dir=",
    SAVE.is_dir(),
)
if SAVE.is_dir():
    print("STEP 2  contents:", [x.name for x in SAVE.iterdir()])

# ---------- STEP 3: upload into Speos RPC file DB ----------
ft = FileTransfer(speos.client)

if SAVE.is_file():
    upload = ft.upload_file(SAVE)
    uri = upload.info.uri
elif SAVE.is_dir():
    names = [x.name for x in SAVE.iterdir() if x.is_file()]
    if not names:
        raise FileNotFoundError(f"No files inside lightbox folder: {SAVE}")
    print("STEP 2c files in folder:", names)
    main = next(
        (
            n
            for n in names
            if n.lower().endswith((".speoslightbox", ".speos", ".sv5"))
        ),
        names[0],
    )
    uploads = ft.upload_folder(SAVE, main_file_name=main)
    uri = uploads[0].info.uri
else:
    raise FileNotFoundError(f"Save path missing: {SAVE}")

print("STEP 3  uploaded URI:", uri)

speos.close()

# ---------- STEP 4: new session, load by URI ----------
speos2 = Speos(channel=default_local_channel(port=50098))
p2 = Project(speos=speos2)
lb = p2.create_lightbox(
    name="LightBox.1",
    lightbox=LightBoxFileInstance(file=uri, password=""),
)
lb.commit()
print("STEP 4  lightbox imported")
print(p2)

speos2.close()
print("STEP 5  done")
